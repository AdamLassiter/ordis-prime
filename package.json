{
  "name": "ordis-prime",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "pnpm --stream --parallel --filter @ordis-prime/web --filter @ordis-prime/ingestion run dev",
    "dev:web": "pnpm --filter @ordis-prime/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "node --experimental-strip-types --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "db:generate": "pnpm --filter @ordis-prime/db generate",
    "db:migrate": "pnpm --filter @ordis-prime/db migrate",
    "data:refresh": "pnpm --filter @ordis-prime/ingestion refresh",
    "data:rankings:overframe": "pnpm data:refresh manual-ranking:data/manual/overframe-warframes.yaml manual-ranking:data/manual/overframe-primary-weapons.yaml manual-ranking:data/manual/overframe-secondary-weapons.yaml manual-ranking:data/manual/overframe-melee-weapons.yaml manual-ranking:data/manual/overframe-archwing.yaml manual-ranking:data/manual/overframe-companions.yaml",
    "data:rankings:creators": "pnpm data:refresh manual-ranking:data/manual/creator-brozime-warframes-2026.yaml manual-ranking:data/manual/creator-salt-prime-coda-weapons-2025.yaml manual-ranking:data/manual/creator-salt-prime-kuva-weapons-2025.yaml manual-ranking:data/manual/creator-salt-prime-tenet-weapons-2025.yaml manual-ranking:data/manual/creator-salt-prime-primary-primes-2026.yaml manual-ranking:data/manual/creator-salt-prime-secondary-primes-2026.yaml manual-ranking:data/manual/creator-salt-prime-melee-primes-2026.yaml",
    "data:worker": "pnpm --filter @ordis-prime/ingestion worker",
    "prettier:check": "prettier --check app/**/* packages/**/*",
    "prettier:fix": "prettier --write apps/**/* packages/**/*"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
